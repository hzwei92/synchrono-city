(ns synchrono.client.write
  (:require
   [reagent.core :as r]
   ["prosemirror-state" :as pm-state]
   ["prosemirror-view" :as pm-view]
   ["prosemirror-model" :as pm-model]
   ["prosemirror-schema-basic" :refer [schema]] ; Corrected import
   ["prosemirror-commands" :as commands]
   ["prosemirror-history" :refer [history]]
   ["prosemirror-keymap" :refer [keymap]]
   [re-frame.core :as rf]
   [clojure.string :as str]
   [taoensso.timbre :as log]
   [cljs.pprint :refer [pprint]]))

(defn unpack-json [m]
  (doseq [[k v] m]
    (println "Key:" k)
    (cond
      ;; If the value is a map, call the function recursively
      (map? v)
      (do
        (println "Value is a nested map:")
        (unpack-json v))

      ;; If the value is a vector (list), iterate through its elements
      (vector? v)
      (do
        (println "Value is a list:")
        (doseq [item v]
          (if (map? item)
            (unpack-json item) ; unpack each map in the list if nested
            (println "List Item:" item))))

      ;; Otherwise, print the value directly
      :else
      (println "Value:" v))))
(def autocomplete-node
  "Defines the custom 'Autocomplete' node specification with 'value' as a string."
  (clj->js
   {:inline true
    :attrs {:value {:default ""}}
    :group "inline"
    :atom false
    :toDOM (fn [node]
             (let [attrs (.-attrs node)
                   value (.-value attrs)]
               ["span" {"class" "autocomplete"
                        "data-value" value} (str "[[" value "]]")]))
    :parseDOM [{:tag "span.autocomplete"
                :getAttrs (fn [dom]
                            {:value (.-value (.-dataset dom))})}]}))

(def tag-node
  "Defines the custom 'Tag' node specification with 'value' as a string."
  (clj->js
   {:inline true
    :attrs {:value {:default ""}}
    :group "inline"
    :atom true
    :toDOM (fn [node]
             (let [attrs (.-attrs node)
                   value (.-value attrs)]
               ["span" {"class" "tag"
                        "data-value" value} (str "[[" value "]]")]))
    :parseDOM [{:tag "span.tag"
                :getAttrs (fn [dom]
                            {:value (.-value (.-dataset dom))})}]}))

(def base-schema (pm-model/Schema. #js {:nodes (.-nodes (.-spec schema))
                                        :marks (.-marks (.-spec schema))}))

(def extended-nodes
  "Defines a schema with a top-level 'doc' node and custom nodes."
  (clj->js
   {"doc" {:content "block+"}
    "paragraph" {:content "inline*", :group "block"
                 :parseDOM #js [#js {:tag "p"}]
                 :toDOM (fn [] (array "p"))}
    "text" {:group "inline"}
    "autocomplete" autocomplete-node
    "tag" tag-node}))


(def extended-schema
  "Final schema including 'doc', custom nodes, and base marks."
  (let [my-schema (pm-model/Schema.
                   #js {:nodes extended-nodes
                        :marks (.-marks (.-spec schema))})]
    my-schema))


(defn handle-open-bracket
  "Handles the '[' key press. Checks for '[[' to insert a Tag node."
  [state dispatch]
  (if (nil? dispatch)
    false
    (let [selection (.-selection state)
          from (.-from selection)
          doc (.-doc state)
          char-before (when (> from 0)
                        (.textBetween doc (dec from) from ""))
          tr (.-tr state)]
      (if (and char-before (= char-before "["))
        ;; User has typed '[['
        (let [tr2 (.delete tr (dec from) from)
              tag-node-type (.-tag (.-nodes extended-schema))
              tag-node (.create tag-node-type #js {:value "tag"})
              tr3 (.insert tr2 from tag-node)]
          (dispatch tr3))
        ;; User has typed a single '['
        (let [tr2 (.insertText tr "[" from)]
          (dispatch tr2)))
      true)))


(defn create-editor-state
  "Creates the editor state with the extended schema and necessary plugins."
  [doc]
  (let [plugins #js [(history)
                     (keymap (.-baseKeymap commands))
                     (keymap (clj->js {"[" handle-open-bracket}))]
        ;; Create the doc node with an empty document
        doc-node (if doc
                   (.parse (.-parser extended-schema) doc)
                   (.createAndFill (.-topNodeType extended-schema))) ; Creates an empty doc
        state-config #js {:schema extended-schema
                          :doc doc-node
                          :plugins plugins}]
    (.create pm-state/EditorState state-config)))

(defn prosemirror-editor
  "ProseMirror editor component with custom Tag node support."
  []
  (let [editor-view (r/atom nil)
        editor-container (r/atom nil)]

    (r/create-class
     {:component-did-mount
      (fn []
        (let [dom-node @editor-container
              initial-state (create-editor-state nil)
              view (pm-view/EditorView.
                    dom-node
                    #js {:state initial-state
                         :dispatchTransaction
                         (fn [tr]=
                           (let [new-state (.apply (.-state @editor-view) tr)]
                             (log/info "New state:" (map #(.-type %) (.-doc new-state)))
                             (.updateState @editor-view new-state)))})]
          (reset! editor-view view)))

      :component-will-unmount
      (fn []
        (when-let [view @editor-view]
          (.destroy view)))

      :reagent-render
      (fn []
        [:div#editor
         {:ref #(reset! editor-container %)}])})))

(defn write
  "Main write component containing the ProseMirror editor."
  []
  [:div.write
   [prosemirror-editor]])

(ns synchrono.client.prompt
  (:require [re-frame.core :as re-frame]))

(defn prompt []
  (let [prompt-open? (re-frame/subscribe [:prompt-open?])]
    [:div.prompt {:class (when-not @prompt-open? "closed")}
     "prompt"]))

(re-frame/reg-sub
 :prompt-open?
 (fn [db]
   (get-in db [:app :prompt-open?])))

(re-frame/reg-event-db
 :toggle-prompt
 (fn [db [_]]
   (update-in db [:app :prompt-open?] not)))

(ns synchrono.client.query-tracker
  (:require ["prosemirror-state" :refer [Plugin]]
            [synchrono.client.schema :refer [schema]]
            [taoensso.timbre :as log]
            [re-frame.core :as rf]))

(rf/reg-event-db
 :queries-updated
 (fn [db [_ queries]]
   (assoc-in db [:drafts :queries] queries)))

(defn extract-queries [doc]
  ;; Traverse the document to find all 'query' nodes and extract their values
  (let [queries (atom [])]
    (.descendants doc
                  (fn [node pos]
                    (log/info "Node:" node "Pos:" pos)
                    (when (= (.-type node) (.-query schema))
                      (swap! queries conj {:value (aget (.-attrs node) "value")
                                           :pos pos}))
                    true))
    (log/info "Extracted Queries:" @queries)
    @queries))

(def query-tracker-plugin
  (Plugin.
   #js {:state
        #js {:init (fn [config]
                     (extract-queries (.-doc config)))
             :apply (fn [tr plugin-state]
                      (let [new-doc (.-doc tr)
                            queries (extract-queries new-doc)]
                        ;; Dispatch a Re-frame event with the updated queries
                        (log/info "Updated Queries:" queries)
                        (rf/dispatch [:queries-updated queries])
                        queries))}}))
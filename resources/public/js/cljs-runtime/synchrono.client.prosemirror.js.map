(ns synchrono.client.prosemirror
  (:require [prosemirror-model :refer [Schema]]
            ["prosemirror-state" :as pm-state]
            ["prosemirror-view" :as pm-view]
            ["prosemirror-commands" :as commands]
            ["prosemirror-history" :as history]
            ["prosemirror-keymap" :refer [keymap]]
            ["react-dom/client" :as rdc]
            [taoensso.timbre :as log]
            [reagent.core :as r]
            [re-frame.core :as rf]
            [clojure.string :as str]))

;; Subscriptions
(rf/reg-sub
 :queries
 (fn [db _]
   (let [draft-list (get-in db [:drafts :drafts-list])
         current-draft-index (get-in db [:drafts :current-draft-index])
         draft (nth draft-list current-draft-index)
         queries (get-in draft [:queries])]
     queries)))

(rf/reg-sub
 :suggestions/for-position
 (fn [db [_ pos]]
   (get-in db [:drafts 
               :drafts-list 
               (get-in db [:drafts :current-draft-index])
               :queries-by-pos 
               pos 
               :suggestions] [])))

(rf/reg-sub
 :suggestions/selected-index
 (fn [db [_ pos]]
   (get-in db [:drafts 
               :drafts-list 
               (get-in db [:drafts :current-draft-index])
               :queries-by-pos 
               pos 
               :selected-index] 0)))



(rf/reg-event-fx
 :prosemirror/update-queries
 (fn [{:keys [db]} [_ query-values]]
   (let [current-draft-index (get-in db [:drafts :current-draft-index])
         queries (get-in db [:drafts :drafts-list current-draft-index :queries])
         queries1 (reduce (fn [acc [pos value]]
                            (let [existing-query (get queries pos)]
                              (if existing-query
                                (assoc-in acc [pos :value] value)
                                (assoc-in acc [pos] {:value value
                                                     :suggestions []
                                                     :selected-index 0}))))
                          {}
                          query-values)]
     {:db (assoc-in db 
                    [:drafts :drafts-list current-draft-index :queries]
                    queries1)})))

(rf/reg-event-db
 :prosemirror/set-selected-index
 (fn [db [_ pos index]]
   (assoc-in db [:drafts
                 :drafts-list
                 (get-in db [:drafts :current-draft-index])
                 :queries
                 pos
                 :selected-index] index)))


(defn suggestions-dropdown [pos]
  (let [suggestions (atom []) #_(rf/subscribe [:suggestions pos])
        selected-index (atom 0) #_(rf/subscribe [:selected-index pos])]
    [:div.suggestion-dropdown
     {:tabIndex 0
      :on-key-down (fn [e]
                     (cond
                       (= (.-key e) "ArrowDown")
                       (do
                         (.preventDefault e)
                         (rf/dispatch [:prosemirror/set-selected-index
                                       pos
                                       (mod (inc @selected-index) (count @suggestions))]))

                       (= (.-key e) "ArrowUp")
                       (do
                         (.preventDefault e)
                         (rf/dispatch [:prosemirror/set-selected-index
                                       pos
                                       (mod (dec @selected-index) (count @suggestions))]))

                       (= (.-key e) "Enter")
                       (do
                         (.preventDefault e)
                         (when-let [selected (nth @suggestions @selected-index nil)]
                           (rf/dispatch [:prosemirror/insert-suggestion pos selected])))))}
     (for [[idx suggestion] (map-indexed vector @suggestions)]
       ^{:key idx}
       [:div.suggestion-item
        {:class (when (= idx @selected-index) "selected")
         :on-mouse-down (fn [e]
                          (.preventDefault e)
                          (rf/dispatch [:prosemirror/insert-suggestion pos suggestion]))}
        suggestion])]))

(defn create-query-node-view [node view-pos view editor-view]
  (let [dom (.createElement js/document "span")
        content (.createElement js/document "span")
        suggestions-container (.createElement js/document "span")
        root (rdc/createRoot suggestions-container)]  ;; Create React root

    ;; Set up DOM structure
    (.setAttribute dom "class" "query")
    (.setAttribute content "class" "query-content")
    (.setAttribute suggestions-container "class" "suggestions")
    (.appendChild dom content)
    (.appendChild dom suggestions-container)

    ;; Mount Reagent component using createRoot
    (.render root (r/as-element [:div "hello"]))

    ;; Create and return the NodeView object
    #js {:dom dom
         :contentDOM content
         :destroy (fn []
                    (.unmount root))
         :update (fn [node decorations innerDecorations]
                   (let [pos (+ view-pos 1)
                         value (.textContent content)]
                     (rf/dispatch [:prosemirror/update-queries pos value])
                     true))
         :ignoreMutation (fn [record] false)}))


(def schema-spec
  #js {:nodes
       #js {:doc
            #js {:content "paragraph+"}

            :paragraph
            #js {:content "(text|tag|query)*"
                 :parseDOM #js [#js {:tag "p"}]
                 :toDOM (fn [] #js ["p" 0])}

            :text
            #js {:group "inline"}

            :tag
            #js {:inline true
                 :group "inline"
                 :content "text*"
                 :attrs #js {:value ""}
                 :atom true
                 :parseDOM #js [#js {:tag "span.tag"}]
                 :toDOM (fn [] #js ["span" #js {:class "tag"} 0])}

            :query
            #js {:inline true
                 :group "inline"
                 :content "text*"
                 :attrs #js {:value ""}
                 :atom false
                 :parseDOM #js [#js {:tag "span.query"}]
                 :toDOM (fn [] #js ["span" #js {:class "query"} 0])}}

       :marks
       #js {:bold
            #js {:parseDOM #js [#js {:tag "strong"}]
                 :toDOM (fn [] #js ["strong" 0])}

            :italic
            #js {:parseDOM #js [#js {:tag "em"}]
                 :toDOM (fn [] #js ["em" 0])}

            :link
            #js {:attrs #js {:href {}}
                 :inclusive false
                 :parseDOM #js [#js {:tag "a"
                                     :getAttrs (fn [dom] #js {:href (.getAttribute dom "href")})}]
                 :toDOM (fn [node] #js ["a" #js {:href (.-href (.-attrs node))} 0])}}})

(def my-schema (Schema. schema-spec))

(defn close-bracket-command [state dispatch]
  (if (nil? dispatch)
    false
    (let [selection (.-selection state)
          from (.-from selection)
          doc (.-doc state)
          tr (.-tr state)
          char-before (when (> from 0)
                        (.textBetween doc (dec from) from ""))
          resolved-pos (.resolve doc from)
          depth (.-depth resolved-pos)
          query-node (loop [d depth]
                       (when (>= d 0)
                         (let [node (.node resolved-pos d)]
                           (if (= (.. node -type -name) "query")
                             node
                             (recur (dec d))))))
          tag-node-type (.. my-schema -nodes -tag)]

      (if (and char-before
               (= char-before "]")
               query-node)
        (let [query-pos (.before resolved-pos (.-depth resolved-pos))
              query-end-pos (.after resolved-pos (.-depth resolved-pos))
              raw-text (.textBetween doc query-pos from "")
              bracketed-text (str raw-text "]")
              text-node (.text my-schema bracketed-text)
              tag-node (.create tag-node-type #js {:value bracketed-text} #js [text-node])
              tr2 (-> tr
                      (.replaceWith (dec query-pos) from tag-node)
                      (.setSelection (pm-state/TextSelection.
                                      (.resolve (.-doc tr)
                                                (+ query-pos (count bracketed-text) 2)))))]
          (dispatch tr2)
          (rf/dispatch [:nostr/search raw-text])
          true)

        (let [tr2 (.insertText tr "]" from)]
          (dispatch tr2)
          true)))))

(defn open-bracket-command [state dispatch]
  (if (nil? dispatch)
    false
    (let [tr (.-tr state)
          selection (.-selection state)
          from (.-from selection)
          doc (.-doc state)
          char-before (when (> from 0)
                        (.textBetween doc (dec from) from ""))
          resolved-pos (.resolve doc from)
          parent-node (.-parent resolved-pos)
          query-node-type (.. my-schema -nodes -query)]

      (cond
        (and char-before
             (= char-before "[")
             (= (.-type parent-node) query-node-type))
        (let [tr2 (.insertText tr "[" from)]
          (dispatch tr2)
          true)

        (and char-before
             (= char-before "[")
             (not= (.-type parent-node) query-node-type))
        (let [tr1 (.delete tr (dec from) from)
              pre-node (.text my-schema " ")
              tr2 (.insert tr1 (dec from) #js [pre-node])
              text-node (.text my-schema "[[")
              query-node (.create query-node-type #js {:value "[["} #js [text-node])
              tr3 (.replaceWith tr2 from from query-node)
              space-node (.text my-schema " ")
              tr4 (.insert tr3 (+ from 4) #js [space-node])
              tr5 (.setSelection tr4 (pm-state/TextSelection. (.resolve (.-doc tr4) (+ from 3))))]
          (dispatch tr5)
          true)

        :else
        (let [tr1 (.insertText tr "[" from)]
          (dispatch tr1)
          true)))))

(defn escape-query-command [state dispatch]
  (if (nil? dispatch)
    false
    (let [selection (.-selection state)
          from (.-from selection)
          doc (.-doc state)
          resolved-pos (.resolve doc from)
          depth (.-depth resolved-pos)
          query-node (loop [d depth]
                       (when (>= d 0)
                         (let [node (.node resolved-pos d)]
                           (if (= (.. node -type -name) "query")
                             node
                             (recur (dec d))))))
          tr (.-tr state)]

      (if query-node
        (let [query-pos (.before resolved-pos (.-depth resolved-pos))
              query-end-pos (.after resolved-pos (.-depth resolved-pos))
              tr2 (-> tr
                      (.delete query-pos query-end-pos)
                      (.setSelection (pm-state/TextSelection.
                                      (.resolve (.-doc tr) (max 0 (dec query-pos))))))]
          (dispatch tr2)
          true)
        false))))

(defn tab-query-command [state dispatch]
  (if (nil? dispatch)
    false
    (let [selection (.-selection state)
          from (.-from selection)
          doc (.-doc state)
          resolved-pos (.resolve doc from)
          depth (.-depth resolved-pos)
          query-node (loop [d depth]
                       (when (>= d 0)
                         (let [node (.node resolved-pos d)]
                           (if (= (.. node -type -name) "query")
                             node
                             (recur (dec d))))))
          tr (.-tr state)]

      (if query-node
        (let [query-pos (.before resolved-pos (.-depth resolved-pos))
              query-end-pos (.after resolved-pos (.-depth resolved-pos))
              raw-text (.textBetween doc query-pos query-end-pos "")
              clean-text (if (re-matches #"\[\[?\]?\]?" raw-text)
                           ""
                           (-> raw-text
                               (str/replace #"^\[\[?" "")
                               (str/replace #"\]?\]$" "")))
              text-node (.text my-schema clean-text)
              tr2 (-> tr
                      (.replaceWith query-pos query-end-pos text-node)
                      (.setSelection (pm-state/TextSelection.
                                      (.resolve (.-doc tr)
                                                (max query-pos (+ query-pos (count clean-text)))))))]
          (dispatch tr2)
          true)
        false))))

(defn make-keymap []
  (keymap
   (clj->js {"[" open-bracket-command
             "]" close-bracket-command
             "Escape" escape-query-command
             "Tab" tab-query-command})))

(def base-plugins
  #js [(history/history)
       (make-keymap)
       (keymap (.-baseKeymap commands))])

(defn create-initial-doc []
  (let [paragraph-type (.. my-schema -nodes -paragraph)
        doc-type (.. my-schema -nodes -doc)
        empty-paragraph (.create paragraph-type)
        doc (.create doc-type #js {:content #js [empty-paragraph]})]
    doc))

(defn create-editor-state []
  (let [doc (create-initial-doc)]
    (.create pm-state/EditorState
             #js {:schema my-schema
                  :doc doc
                  :plugins base-plugins})))

(defn create-editor-view [dom-node state dispatch-transaction]
  (pm-view/EditorView.
   dom-node
   #js {:state state
        :dispatchTransaction dispatch-transaction
        :nodeViews #js {:query create-query-node-view}
        :handleDOMEvents #js {:focus (fn [view event]
                                       true)
                              :blur (fn [view event]
                                      true)}
        :editable (fn [] true)}))

(defn editor []
  (let [editor-ref (r/atom nil)
        container-ref (r/atom nil)]
    (r/create-class
     {:component-did-mount
      (fn []
        (when-let [dom-node @container-ref]
          (let [initial-state (create-editor-state)
                dispatch-fn (fn [tr]
                              (when-let [view @editor-ref]
                                (let [next-state (.apply (.-state view) tr)]
                                  (log/info "next-state" (.-doc next-state))
                                  (.updateState view next-state))))
                view (create-editor-view dom-node initial-state dispatch-fn)]
            (reset! editor-ref view))))

      :component-will-unmount
      (fn []
        (when-let [view @editor-ref]
          (.destroy view)))

      :reagent-render
      (fn []
        [:div.hello
         {:ref #(reset! container-ref %)}])})))
(ns synchrono.client.extensions.autocomplete
  (:require ["@tiptap/core" :refer [Extension]]
            ["@tiptap/pm/state" :refer [Plugin PluginKey]]
            ["@tiptap/pm/view" :refer [Decoration DecorationSet]]))

(def autocomplete-extension
  (.create Extension
    (clj->js
      {:name "autocomplete"
       :addOptions (fn []
         #js {:triggerChar "@"
              :suggestionDebounce 800
              :getSuggestions nil})
       
       :addProseMirrorPlugins
       (fn []
         (let [plugin-key (PluginKey. "autocomplete")]
           [(Plugin.
              #js {:key plugin-key
                   :state #js {:init (fn [] 
                                     (.empty DecorationSet))
                             :apply (fn [tr old-state]
                                     (if (.getMeta tr plugin-key)
                                       (.. tr (getMeta plugin-key) -decorations)
                                       (if (.-docChanged tr)
                                         (.map old-state (.-mapping tr) (.-doc tr))
                                         old-state)))}
                   
                   :view (fn []
                          #js {:update (fn [view prev-state]
                                       (let [selection (.. view -state -selection)
                                             cursor-pos (.. selection -$head -pos)
                                             next-node (.. view -state -doc (nodeAt cursor-pos))]
                                         
                                         (when (and next-node (not (.-isBlock next-node)))
                                           (let [suggestion-decoration
                                                 (.widget Decoration 
                                                   cursor-pos
                                                   (fn []
                                                     (let [parent (.createElement js/document "span")]
                                                       (set! (.-innerHTML parent) "suggestion text")
                                                       (.. parent -classList (add "autocomplete-suggestion"))
                                                       parent))
                                                   #js {:side 1})]
                                             
                                             (let [decorations (.create DecorationSet 
                                                              (.. view -state -doc)
                                                              #js [suggestion-decoration])
                                                   tr (.. view -state -tr)]
                                               (.setMeta tr plugin-key #js {:decorations decorations})
                                               (.dispatch view tr))))))})
                   
                   :props #js {:decorations (fn [state]
                                            (.getState this state))}})]))}))) 
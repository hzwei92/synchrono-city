(ns synchrono.client.extensions.nostr-tag.nostr-tag-suggestion
  (:require [synchrono.client.extensions.nostr-tag.find-nostr-tag-match :refer [find-nostr-tag-match]]))

(def nostr-tag-suggestion
  (clj->js
    {:char "[["
     :allowSpaces true
     :decorationTag "span"
     :decorationClass "nostr-tag-suggestion"
     
     :items (fn [{:keys [query]}]
              (let [parts (-> query
                            (.split " ")
                            (.filter #(not (empty? %))))
                    [type id marker] parts]
                ;; Example items - replace with actual implementation
                #js [{:id "npub1..." :type "e" :marker "root"}
                     {:id "npub2..." :type "e" :marker "reply"}]))
     
     :findSuggestionMatch (fn [{:keys [$position]}]
                           (find-nostr-tag-match $position))
     
     :command (fn [{:keys [editor range props]}]
                (let [{:keys [id type marker]} (js->clj props :keywordize-keys true)
                      nostr-tag (str "[" type " " id " \"" marker "\"]")]
                  (.. editor
                      chain
                      focus
                      (insertContentAt range nostr-tag)
                      run)))
     
     :render (fn []
               (let [popup-atom (atom nil)]
                 #js {:onStart (fn [props]
                                (let [popup (.createElement js/document "div")]
                                  (set! (.-className popup) "nostr-tag-popup")
                                  (.appendChild js/document.body popup)
                                  (reset! popup-atom popup)))
                      
                      :onUpdate (fn [props]
                                 ;; Update popup content
                                 nil)
                      
                      :onKeyDown (fn [{:keys [event]}]
                                  ;; Handle keyboard navigation
                                  false)
                      
                      :onExit (fn []
                               (when-let [popup @popup-atom]
                                 (.remove popup)
                                 (reset! popup-atom nil)))}))})) 
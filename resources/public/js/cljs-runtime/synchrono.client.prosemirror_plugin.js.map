(ns synchrono.client.prosemirror-plugin
  (:require ["prosemirror-state" :as pm-state]
            ["prosemirror-view" :as pm-view]
            [re-frame.core :as rf]
            [reagent.core :as r]
            [reagent.dom :as rdom]))

(defn make-prosemirror-plugin []
  (pm-state/Plugin.
   #js {:view
        (fn [editor-view]
          (let [;; Optional: Hold references to any Reagent components here
                autosuggest-container (atom nil)]
            ;; Plugin view lifecycle methods
            (reify
              Object
              ;; Trigger on each ProseMirror update to monitor for query nodes
              (update [_ view last-state]
                (let [{:keys [from to]} (.-selection (.-state view))
                      doc (.-doc (.-state view))]
                  (.nodesBetween doc from to
                    (fn [node pos]
                      (when (= (.. node -type -name) "query")
                        ;; Target `span.query` for autosuggest rendering
                        (let [dom-node (.nodeDOM view pos)]
                          (when (and dom-node (not @autosuggest-container))
                            ;; Mount Reagent autosuggest component
                            (rf/dispatch [:show-autosuggest-dropdown dom-node]))))))))
              
              ;; Optional cleanup for unmounting autosuggest
              (destroy [_]
                (when @autosuggest-container
                  (r/unmount-component-at-node @autosuggest-container)
                  (reset! autosuggest-container nil))))))}))

(defn autosuggest-dropdown []
  (let [suggestions ["e" "p" "s" "t"]]
    [:div.autosuggest-dropdown
     (for [option suggestions]
       [:div.autosuggest-item
        {:on-click #(rf/dispatch [:select-prefix option])}
        option])]))

(rf/reg-event-fx :show-autosuggest-dropdown 
                 (fn [{:keys [db]} [_ dom-node]]
                   (rdom/render [autosuggest-dropdown] dom-node)))

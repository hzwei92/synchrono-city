(ns synchrono.client.color
  (:require [clojure.string :as str]))

(defn adjust-color
  "Ensure color value is within visible range"
  [c]
  (let [min-brightness 60
        max-brightness 220]
    (-> c
        (max min-brightness)
        (min max-brightness))))

(defn hex->int
  "Convert two hex chars to integer"
  [hex-str]
  (js/parseInt hex-str 16))


(defn int->hex-str
  "Convert integer to two-char hex string"
  [n]
  (.padStart (.toString n 16) 2 "0"))

(defn pubkey->color
  "Convert a Nostr pubkey to consistent color formats"
  [pubkey]
  (let [clean-key (str/replace pubkey "npub" "")
        r (-> clean-key (subs 0 2) hex->int adjust-color)
        g (-> clean-key (subs 2 4) hex->int adjust-color)
        b (-> clean-key (subs 4 6) hex->int adjust-color)]
    {:rgb (str "rgb(" r ", " g ", " b ")")
     :hex (str "#" (int->hex-str r) (int->hex-str g) (int->hex-str b))
     :values [r g b]}))
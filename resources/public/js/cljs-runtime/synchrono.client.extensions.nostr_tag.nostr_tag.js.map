(ns synchrono.client.extensions.nostr-tag.nostr-tag
  (:require ["@tiptap/core" :refer [Extension]]
            ["@tiptap/suggestion" :default Suggestion]
            [synchrono.client.extensions.nostr-tag.nostr-tag-suggestion :refer [nostr-tag-suggestion]]))

(def NostrTag
  (.create Extension
          (clj->js
            {:name "nostrTag"
             
             :addOptions (fn []
                          #js {:suggestion nostr-tag-suggestion})
             
             :addProseMirrorPlugins (fn []
                                     #js [(Suggestion.
                                           (clj->js
                                             {:editor (.-editor this)
                                              :suggestion (.. this -options -suggestion)}))])}))) 
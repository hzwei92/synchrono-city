(ns synchrono.client.ws
  (:require [re-frame.core :as re-frame]))

(defonce ws-connections (atom {}))

(defn connect-websocket [url]
  (println "Connecting to WebSocket at" url)
  (when-not (@ws-connections url)
    (let [ws (js/WebSocket. url)]
      (set! (.-onopen ws)
            (fn [event]
              (re-frame/dispatch [:ws-connected url])
              (js/console.log (str "WebSocket connected to " url " (" event ")"))))
      (set! (.-onmessage ws)
            (fn [event]
              (let [data (js/JSON.parse (.-data event))]
                (re-frame/dispatch [:ws-received-message data url]))))
      (set! (.-onclose ws)
            (fn [event]
              (re-frame/dispatch [:ws-disconnected url])
              (js/console.log (str "WebSocket disconnected from " url " (" event ")"))
              (swap! ws-connections dissoc url)))
      (set! (.-onerror ws)
            (fn [error]
              (js/console.error (str "WebSocket error on " url ":") error)))
      (swap! ws-connections assoc url ws))))

(defn send-ws-message [message]
  (doseq [[url ws] @ws-connections]
    (.send ws (js/JSON.stringify message))))

(defn send-ws-event [event]
  (let [message {:type "event"
                 :data event}]
    (send-ws-message message)))

(re-frame/reg-event-fx
 :ws-connected
 (fn [{:keys [db]} [_ url]]
   (let [relays-list (get-in db [:relays :relays-list])
         relay-index (.findIndex (to-array relays-list) #(= (:url %) url))]
     {:db (assoc-in db [:relays :relays-list relay-index :connected?] true)})))

(re-frame/reg-event-fx
 :ws-disconnected
 (fn [{:keys [db]} [_ url]]
   (let [relays-list (get-in db [:relays :relays-list])
         relay-index (.findIndex (to-array relays-list) #(= (:url %) url))]
     {:db (assoc-in db [:relays :relays-list relay-index :connected?] false)})))

(re-frame/reg-fx
 :ws-send
 (fn [{:keys [message event]}]
   (cond
     message
     (send-ws-message message)
     event
     (send-ws-event event))))

(re-frame/reg-event-fx
 :ws-received-message
 (fn [{:keys [db]} [_ data url]]
    ;; Process the received data and dispatch necessary events
    ;; Example: Dispatching different events based on message type
   (let [message-type (:type data)]
     (case message-type
       "event" {:dispatch [:handle-server-event (:data data)]}
       "response" {:dispatch [:handle-server-response (:data data)]}
        ;; Add more cases as needed
       {}))))

(re-frame/reg-event-db
 :handle-server-event
 (fn [db [_ event-data]]
    ;; Update the app state based on the event data
    ;; Example: Adding a new contract received from the server
   (update db :contracts conj event-data)))

(re-frame/reg-event-db
 :handle-server-response
 (fn [db [_ response-data]]
    ;; Update the app state based on the response data
    ;; Example: Updating account information
   (assoc db :server-response response-data)))
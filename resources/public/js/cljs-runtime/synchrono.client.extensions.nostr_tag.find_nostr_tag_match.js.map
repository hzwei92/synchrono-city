(ns synchrono.client.extensions.nostr-tag.find-nostr-tag-match)

(defn find-nostr-tag-match [$position]
  (when (= (.. $position -parent -type -name) "paragraph")
    (let [text (.-textContent (.-parent $position))
          trigger "[["
          current-position (.-parentOffset $position)
          trigger-index (.lastIndexOf text trigger (dec current-position))]
      
      (when-not (= trigger-index -1)
        (let [text-after-trigger (.slice text 
                                       (+ trigger-index (count trigger)) 
                                       current-position)
              parts (-> text-after-trigger
                       (.split " ")
                       (.filter #(not (empty? %))))]
          
          ;; Only proceed if we have valid parts (3 or fewer)
          (when (<= (count parts) 3)
            (clj->js
              {:range {:from trigger-index
                      :to current-position}
               :query text-after-trigger
               :text (.slice text trigger-index current-position)}))))))) 


(def NostrTagSuggestion
  (.create Extension (clj->js
                      {:name "nostrTagSuggestion"
                       :addOptions
                       (fn []
                         #js {:suggestion
                              #js {:char "[["
                                   :allowSpaces true
                                   :decorationTag "span"
                                   :decorationClass "nostr-tag-suggestion"
                                   :items (fn [props]
                                            (let [query (.-query props)
                                                  parts (-> query
                                                            (.split " ")
                                                            (.filter #(not (empty? %))))
                                                  [type id marker] parts]
                                              (if (empty? parts)
                                                #js []
                                                #js [{:id "note1..." :type "e" :marker "root"}
                                                     {:id "note2..." :type "e" :marker "reply"}])))
                                   :findSuggestionMatch find-nostr-tag-match
                                   :command (fn [props]
                                              (try
                                                (let [editor (.-editor props)]
                                                  (when editor
                                                    (let [item (.-item props)]
                                                      (.. editor
                                                          (chain)
                                                          (insertContent #js {:type "nostrTagNode"
                                                                              :attrs #js {:id (.-id item)
                                                                                          :type (.-type item)
                                                                                          :marker (.-marker item)}})
                                                          run))))
                                                (catch :default e
                                                  (log/error "Error in nostr tag command:" e))))
                                   :render (fn [props]
                                             (let [popup-atom (atom nil)]
                                               #js {:onStart (fn [props]
                                                               (try
                                                                 (let [popup (.createElement js/document "div")]
                                                                   (set! (.-className popup) "nostr-tag-popup")
                                                                   (.appendChild js/document.body popup)
                                                                   (reset! popup-atom popup))
                                                                 (catch :default e
                                                                   (log/error "Error in nostr tag popup creation:" e))))
                                                    :onUpdate (fn [props]
                                                                (try
                                                                  (when-let [popup @popup-atom]
                                                                    (let [items (.-items props)
                                                                          command (.-command props)]
                                                                      (set! (.-innerHTML popup) "")
                                                                      (doseq [item items]
                                                                        (let [button (.createElement js/document "button")]
                                                                          (set! (.-className button) "nostr-tag-item")
                                                                          (set! (.-textContent button)
                                                                                (str (.-type item) ": " (.-id item)))
                                                                          (.addEventListener button "click"
                                                                                             #(command item))
                                                                          (.appendChild popup button)))))
                                                                  (catch :default e
                                                                    (log/error "Error in nostr tag popup update:" e))))
                                                    :onKeyDown (fn [props]
                                                                 (let [event (.-event props)]
                                                                   (case (.-key event)
                                                                     "ArrowUp" (do (.preventDefault event) true)
                                                                     "ArrowDown" (do (.preventDefault event) true)
                                                                     "Enter" (do (.preventDefault event) true)
                                                                     false)))
                                                    :onExit (fn [_props]
                                                              (when-let [popup @popup-atom]
                                                                (.remove popup)
                                                                (reset! popup-atom nil)))}))}})
                       :addProseMirrorPlugins
                       (fn [] (this-as this
                                       #js [(new Suggestion (.. this -options -suggestion))]))})))

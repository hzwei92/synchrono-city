{:source-paths ["src/cljs"]
 :dependencies [[reagent "1.2.0"]
                [re-frame "1.4.2"]]
 
 :dev-http {8280 "resources/public"}
 
 :npm-deps {"aes-js" "latest"
            "@noble/hashes" "latest"
            "@noble/ciphers" "latest"
            "nostr-tools" "latest"
            "react" "18.3.1"
            "react-dom" "18.3.1"}
 
 :builds
 {:app {:target :browser
        :output-dir "resources/public/js"
        :asset-path "/js"
        :modules {:main {:init-fn synchrono.client.core/init}}
        :devtools {:preloads []}
        :dev {:compiler-options
              {:closure-defines {}}}
        :release {:build-options
                 {:ns-aliases {}}}}}}